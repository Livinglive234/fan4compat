{
  "schemaVersion": 1,
  "id": "fan4compat",
  "version": "${version}",
  "name": "Fan4Compat",
  "description": "Optional Fabric 1.21.1 fixes for installed supported mods and mod combinations.",
  "icon": "assets/fan4compat/icon.png",
  "license": "MIT",
  "contact": {
    "sources": "https://github.com/Livinglive234/fan4compat"
  },
  "environment": "*",
  "mixins": [
    "fan4compat.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "dev.fan4.compat.eureka.CompatSettings",
      "dev.fan4.compat.updater.UpdateInitializer",
      "dev.fan4.compat.xaero.XaeroSyncInitializer"
    ],
    "modmenu": [
      "dev.fan4.compat.config.ModMenuEntry"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "mixinsquared": ">=0.2.0-beta.6"
  },
  "jars": [
    {
      "file": "META-INF/jars/mixinsquared-fabric.jar"
    }
  ]
}
